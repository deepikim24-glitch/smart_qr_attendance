NODE_ENV=development
PORT=3000

# PostgreSQL (local Docker defaults — change before any real deployment)
DATABASE_URL=postgres://attendance:attendance_dev_only@localhost:5432/smart_qr_attendance

# JWT — generate a long random value for anything beyond local demos
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# CORS — comma-separated origins, or * for local development only
CORS_ORIGIN=*

# Optional geofence. Radius 0 disables enforcement.
# Device GPS cannot independently prove physical presence.
GEOFENCE_ENABLED=false
GEOFENCE_RADIUS_METERS=0
OFFICE_LATITUDE=11.6643
OFFICE_LONGITUDE=78.1460

# Seed accounts (local/demo only — never use these in production)
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_EMPLOYEE_NAME=Jane Employee
SEED_EMPLOYEE_EMAIL=employee@company.com
SEED_EMPLOYEE_PASSWORD=Employee@12345

BCRYPT_ROUNDS=12
DEFAULT_QR_EXPIRY_SECONDS=120
